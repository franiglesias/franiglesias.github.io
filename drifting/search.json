---
layout: null
permalink: /drifting/search.json
---
[
  {% assign first = true %}
  {% if site.drifting %}
  {% for post in site.drifting %}
    {% unless post.hide %}
      {% if first %}{% assign first = false %}{% else %},{% endif %}
      {
        "title"    : {{ post.title | jsonify }},
        "url"      : {{ post.url | relative_url | jsonify }},
        "date"     : {{ post.date | date: "%d/%m/%Y" | jsonify }},
        "content"  : {{ post.content | strip_html | strip_newlines | truncatewords: 50 | jsonify }}
      }
    {% endunless %}
  {% endfor %}
  {% endif %}
]
